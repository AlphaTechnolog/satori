.{
    .name = .satori,
    .version = "0.1.0",
    .fingerprint = 0x1697f96f60e5580d,
    .minimum_zig_version = "0.17.0",

    // Deliberately empty. satori's whole design rests on the default path
    // touching no package manager code: every dependency is a build-time or
    // startup-time tax we have measured and refused. CI asserts this stays empty.
    .dependencies = .{},

    .paths = .{
        "AGENTS.md",
        "MEMORY.md",
        "build.zig",
        "build.zig.zon",
        "src",
        "test",
        "logos",
        "tools",
        // README.md is listed for the same reason LICENSE was: it does not exist
        // yet, and dropping a path from this list is silent. Add it when written.
        "LICENSE",
        "README.md",
    },
}
